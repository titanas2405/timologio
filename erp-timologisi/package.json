{
  "name": "erp-timologisi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
